{
	"name": "gulp-stacksvg",
	"description": "The gulp plugin to combine svg files into one using the stack method.",
	"version": "6.1.1",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/gulp-stacksvg#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/gulp-stacksvg/issues"
	},
	"repository": {
		"type": "git",
		"url": "git://github.com/firefoxic/gulp-stacksvg.git"
	},
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"./dist/"
	],
	"engines": {
		"node": ">=22.22"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=26.13",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.19",
			"onFail": "download"
		}
	},
	"dependencies": {
		"node-html-parser": "^9.0.1",
		"plugin-error": "^2.0.1",
		"vinyl": "^3.0.1"
	},
	"scripts": {
		"help": "make help"
	},
	"peerDependencies": {
		"gulp": "^5.0.1"
	},
	"devDependencies": {
		"@firefoxic/oxlint-config": "~0.6",
		"@types/gulp": "^4.0.18",
		"@types/node": "^26",
		"@types/vinyl": "^2.0.12",
		"@vitest/coverage-v8": "^4.1.10",
		"gulp": "^5.0.1",
		"oxlint": "^1.93",
		"tsrs": "~0.25.0-ts7",
		"vitest": "^4.1.10"
	},
	"keywords": [
		"gulp",
		"gulpplugin",
		"svg",
		"icon",
		"sprite",
		"stack",
		"vector"
	]
}
